{
	"schemaVersion": 1,
	"id": "sparethesympathy",
	"version": "${version}",
	"name": "Spare the Sympathy",
	"description": "Save and share your Monumenta builds with sts.deepa.cat. Export your loadout from the Mechanical Armory, view other players' builds, and upload items and builds to your profile.",
	"authors": [
		"jkitter (jc)",
		"Deepacat"
	],
	"license": "GPL-3.0",
	"icon": "assets/sparethesympathy/icon.png",
	"contact": {
		"homepage": "https://sts.deepa.cat",
		"issues": "https://github.com/JacyKu/spare-the-sympathy-mod/issues"
	},
	"environment": "client",
	"accessWidener": "sparethesympathy.accesswidener",
	"mixins": [
		"sparethesympathy.client.mixins.json"
	],
	"entrypoints": {
		"main": [
			"sts.mod.SpareTheSympathy"
		],
		"client": [
			"sts.mod.client.SpareTheSympathyClient"
		],
		"modmenu": [
			"sts.mod.client.StsModMenuIntegration"
		]
	},
	"depends": {
		"fabricloader": ">=0.18.6",
		"minecraft": "~1.20.4",
		"java": ">=17",
		"fabric-api": "*",
		"citresewn": ">=1.1.4 <=1.1.5",
		"cloth-config": ">=13.0.138",
		"entity_model_features": ">=3.0.10",
		"entity_texture_features": ">=7.0.8"
	},
	"suggests": {
		"modmenu": "*"
	}
}
