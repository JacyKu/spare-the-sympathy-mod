{
	"schemaVersion": 1,
	"id": "sparethesympathy",
	"version": "${version}",
	"name": "Spare the Sympathy",
	"description": "Deep integration with sts.deepa.cat for Monumenta: save, share and export builds from the Mechanical Armory, cache other players' builds with /ps, /pa and /vc to upload or link them, upload in-game items as custom items, and dump resource pack textures into STS spritesheets.",
	"authors": [
		"jkitter (jc)",
		"Deepacat"
	],
	"license": "CC0-1.0",
	"icon": "assets/sparethesympathy/icon.png",
	"environment": "client",
	"accessWidener": "sparethesympathy.accesswidener",
	"mixins": [
		"sparethesympathy.client.mixins.json"
	],
	"entrypoints": {
		"main": [
			"sts.mod.SpareTheSympathy"
		],
		"client": [
			"sts.mod.client.SpareTheSympathyClient"
		],
		"modmenu": [
			"sts.mod.client.StsModMenuIntegration"
		]
	},
	"depends": {
		"fabricloader": ">=0.18.6",
		"minecraft": "~1.20.4",
		"java": ">=17",
		"fabric-api": "*",
		"citresewn": ">=1.1.4 <=1.1.5",
		"cloth-config": ">=13.0.138"
	},
	"suggests": {
		"modmenu": "*"
	}
}
